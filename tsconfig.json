{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./node_modules/@annangela/eslint-config/dist/tsconfigs/tsconfig.browser.json",
    "compilerOptions": {
        "noEmit": true,
        "checkJs": false,
        "target": "es2020",
        "jsx": "react",
        "allowImportingTsExtensions": true,
        "types": ["types-mediawiki", "node"]
    },
    "include": ["src/**/*", "tests/**/*", "scripts/**/*", "vitest.config.ts"]
}
